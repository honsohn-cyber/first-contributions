# Server
PORT=8787

# Optional: OpenAI API key. When set, AI Video Studio uses it for:
#  - high quality text-to-speech narration (gpt-4o-mini-tts)
#  - AI generated scene illustrations (gpt-image-1)
# When left empty, the app automatically falls back to a fully offline
# pipeline (espeak-ng narration + procedurally generated gradient cards),
# so the app works out of the box with zero API keys.
OPENAI_API_KEY=

# Where generated jobs/videos are stored on disk.
STORAGE_DIR=./storage
