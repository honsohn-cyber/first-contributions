# Server
PORT=8787

# Optional: ElevenLabs API key. When set, AI Video Studio uses it for high
# quality narration with a curated selection of ElevenLabs voices (Rachel,
# Domi, Bella, Elli, Antoni, Josh, Arnold, Adam). When left empty, the app
# automatically falls back to offline narration via espeak-ng, so the app
# works out of the box with zero API keys.
ELEVENLABS_API_KEY=

# Optional: OpenAI API key. When set, AI Video Studio uses it for AI
# generated scene illustrations (gpt-image-1). When left empty, scenes use
# procedurally generated gradient title cards instead.
OPENAI_API_KEY=

# Where generated jobs/videos are stored on disk.
STORAGE_DIR=./storage
